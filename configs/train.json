{
  "model_config": "configs/model.json",
  "tokenizer_dir": "data/tokenizer",
  "train_data": "data/public/train.jsonl",
  "val_data": "data/public/validation.jsonl",
  "sft_data": "data/public/sft.jsonl",
  "out_dir": "checkpoints",
  "log_dir": "logs",
  "seed": 1337,
  "cpu_threads": 4,
  "batch_size": 1,
  "grad_accum": 4,
  "learning_rate": 0.0003,
  "min_lr": 3e-05,
  "weight_decay": 0.1,
  "warmup_steps": 500,
  "max_steps": 7000,
  "eval_interval": 100,
  "eval_batches": 30,
  "save_interval": 100,
  "grad_clip": 1.0,
  "log_interval": 10,
  "shuffle_buffer": 128,
  "device": "auto"
}
